<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>acorn</ToolCommandName>
    <PackageId>Acorn.Dataverse.Cli</PackageId>
    <Description>Deploys Dataverse plug-in packages from [PluginStep] and [PluginImage] declarations.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="System.Reflection.MetadataLoadContext" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Acorn.Dataverse.Plugins.Registration\Acorn.Dataverse.Plugins.Registration.csproj" />
    <ProjectReference Include="..\Acorn.Dataverse.Core\Acorn.Dataverse.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Acorn.Dataverse.Cli.Tests" />
  </ItemGroup>
</Project>